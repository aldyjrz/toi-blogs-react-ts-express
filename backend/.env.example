# Backend Environment Example
# Copy to backend/.env and fill values

# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173,http://localhost:80,http://localhost

# Supabase Database (Prisma uses this as the database URL)
# Replace [YOUR-PASSWORD] with the real Supabase DB password
DATABASE_URL="postgresql://postgres:XNXX@db.xnxx.supabase.co:5432/postgres?schema=public"

# Supabase
SUPABASE_URL="https://xnxx.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xnxx"
SUPABASE_SECRET_KEY="sb_secret_xnxx"
SUPABASE_STORAGE_BUCKET="media"

# Auth
JWT_SECRET="kembalikealqurandansunnah"
JWT_REFRESH_SECRET="pengen-jadi-programmer-handal-namun-enggan-ngoding"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
BCRYPT_SALT_ROUNDS=12

# Frontend public URL (used for sitemap / canonical generation)
SITE_URL="http://localhost:5173"

# Rate limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
